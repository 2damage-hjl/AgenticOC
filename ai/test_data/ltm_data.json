          "tsundere",
          "food"
        ],
        "emotional_valence": 0.8
      },
      {
        "memory_id": "evt_Damon_dd18bc00",
        "memory_type": "episodic_event",
        "npc_id": "Damon",
        "content": "我对玩家说了一句很丢脸的话：'我以前觉得安定下来是一种放弃。现在觉得，也许这才是我一直在找的东西。'说出口以后反而轻松了。",
        "time": 35,
        "location": "Beach",
        "importance": 0.85,
        "status": "active",
        "last_access": 35,
        "source": "test_data",
        "topic_tags": [
          "growth",
          "reflection",
          "belonging"
        ],
        "emotional_valence": 0.9
      },
      {
        "memory_id": "evt_Damon_45841c12",
        "memory_type": "episodic_event",
        "npc_id": "Damon",
        "content": "秋天傍晚在山间对玩家说'秋天的山谷……我开始觉得这里比城市好了'。说完我自己都愣了一下——以前我绝对不会说这种话。",
        "time": 28,
        "location": "Mountain",
        "importance": 0.75,
        "status": "active",
        "last_access": 28,
        "source": "test_data",
        "topic_tags": [
